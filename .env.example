# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Commerce foundation (PR1, mvp-completo) ---
# Supabase project (prod + preview share the same project; callbacks pinned in PR2).
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# Server-only. Used by api/* with service_role. Never expose with VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Canonical WhatsApp business number in international format, digits only.
WHATSAPP_NUMBER="59167624420"
# Browser override for the wa.me order-confirm link (same canonical number).
VITE_WHATSAPP_NUMBER="59167624420"
# Canonical pickup address text shown at checkout (Spanish).
PICKUP_ADDRESS="Calle Arenales #7, Plaza 25 de Mayo, Sucre"

# --- Social auth (PR2, mvp-completo) ---
# Browser keys (VITE_ prefix required). Same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
# Callback allow-list (Supabase Dashboard > Auth > URL Configuration):
# - https://chocolates-zeta.vercel.app/**
# - https://*.vercel.app/** (previews)
# Mismatch shows Spanish error, no partial session (see src/lib/supabase.ts).
# --- Admin catalog (PR5, mvp-completo) ---
# MVP gate: email allow-list (comma-separated). Server checks ADMIN_EMAILS, client checks VITE_ADMIN_EMAILS.
ADMIN_EMAILS="admin@ejemplo.bo"
VITE_ADMIN_EMAILS="admin@ejemplo.bo"
# Future: replace allow-list with profiles.is_admin flag (table exists in 001_commerce.sql).
# Photos MVP: /public placeholders (/images/placeholder.svg). Supabase Storage deferred.
